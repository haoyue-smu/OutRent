{
  "name": "outrent",
  "private": true,
  "type": "module",
  "description": "OutRent Iter2 prototype workspace. Team pages: Node 20+ only, no dependencies. Final app: React in app/ (npm run app:dev).",
  "scripts": {
    "setup": "node tools/setup.mjs",
    "new": "node tools/new.mjs",
    "dev": "node tools/serve.mjs",
    "check": "node tools/check.mjs",
    "app:dev": "npm --prefix app run dev",
    "app:build": "npm --prefix app run build",
    "check:app": "node tools/check.mjs --app"
  },
  "engines": {
    "node": ">=20"
  }
}
